@page "/team/{teamid}"
@using MLB_Database.Services
@using MLB_Database.Data
@using Microsoft.EntityFrameworkCore
@using MLB_Database.Components
@using System.Text.Json

@inject MyDbContext DbContext
@inject MlbApiService MLBAPI
@inject PlayByPlayService PlayByPlayService
@inject IJSRuntime JS

@implements IDisposable

@if (contentLoading)
{
    <div class="loading">
        <img src="../Logos/brewers-@(TeamId).png" />
        <div class="loading-text">Loading...</div>
    </div>
}
else
{
    @if (TeamRoster == null)
    {
        <div class="loading">
            <img src="../Logos/@(TeamId).png" />
            <div class="loading-text">Team Not Found</div>
        </div>
    }
    else
    {
        <header class="@TeamRoster.Team_Abreviation">
            <div class="header-row">
                <img id="team-logo" style="margin-left: 1rem;" src="@GetLogoUrl(TeamRoster.MLBId)" />
                <div id="team-name">@TeamRoster.Team_Name</div>
                <a href="/" style="width: fit-content;"><div class="info-box">Back</div></a>
            </div>
        </header>

        <div class="team-info-background">
            <div class="team-info">
                @if (Standing == "1st")
                {
                    <div class="info-box green" title="@($"1st in {TeamRoster.Team_Division}")">@Standing</div>
                }
                else if (Standing == "5th")
                {
                    <div class="info-box pink" title="@($"5th in {TeamRoster.Team_Division}")">@Standing</div>
                }
                else
                {
                    <div class="info-box" title="@($"Standing in {TeamRoster.Team_Division}")">@Standing</div>
                }

                @if (Clinched)
                {
                    <div class="info-box green" title="Clinched Playoffs">Clinched</div>
                }

@*                 @if (!string.IsNullOrEmpty(StreakCode) && StreakCode.Contains("W"))
                {
                    <div class="info-box green" title="Streak">Streak: @StreakCode</div>
                }
                else if (!string.IsNullOrEmpty(StreakCode) && StreakCode.Contains("L"))
                {
                    <div class="info-box pink" title="Streak">Streak: @StreakCode</div>
                } *@
                else
                {
                    <div class="info-box" title="Streak">Streak: -</div>
                }

                <div class="info-box" title="Games Back">Games Back: @GamesBack</div>
                <div class="info-box" title="Overall Team Record">Record: @Wins-@Losses</div>
                <div class="info-box" title="Win/Loss %">PCT: @WinPercentage%</div>

                @if (HasGames)
                {
                    <div class="next-game" title="@GameDay">
                        <div>@GameTimeFormat</div>
                        <div>@AwayTeamWins-@AwayTeamLosses</div>
                        <img src="../Logos/@AwayTeamDb.Team_Logo" />
                        <img src="../Logos/@HomeTeamDb.Team_Logo" />
                        <div style="font-size: 16px;">@HomeTeamWins-@HomeTeamLosses</div>
                    </div>
                }
                else
                {
                    <div class="next-game">No Game Today</div>
                }

                <div class="info-box" title="@($"{TeamRoster.Team_Abreviation} Baseball Reference")">
                    <a href="https://www.baseball-reference.com/teams/@TeamRoster.Team_Abreviation/2025.shtml" target="_blank">
                        <img src="../logos/ref.png" style="height: 16px;" />
                    </a>
                </div>
                <div class="info-box"><img src="../Logos/@TeamRoster.Team_League_Logo" />@TeamRoster.Team_League</div>
                <div class="info-box">Established: @TeamRoster.Team_Established</div>
                <div class="info-box">Ballpark: @TeamRoster.Team_Ballpark</div>
                <a href="@TeamRoster.Team_URL" style="width: fit-content" target="_blank">
                    <div class="info-box">News</div>
                </a>
            </div>
        </div>

        <div class="team-row">
            <div class="rosters">
                <PlayerList Players="Infielders" PositionType="Infielders" CssClass="yellow" KvPPlayerIdPlayerHittingStats="KvPPlayerIdPlayerHittingStats" />
                <PlayerList Players="Catchers" PositionType="Catchers" CssClass="blue" KvPPlayerIdPlayerHittingStats="KvPPlayerIdPlayerHittingStats" />
                <PlayerList Players="Outfielders" PositionType="Outfielders" CssClass="green" KvPPlayerIdPlayerHittingStats="KvPPlayerIdPlayerHittingStats" />
                @if (DH.Count > 0)
                {
                    <PlayerList Players="DH" PositionType="Designated Hitter" CssClass="purple" KvPPlayerIdPlayerHittingStats="KvPPlayerIdPlayerHittingStats" />
                }
                @if (TwoWay.Count > 0)
                {
                    <TwoWayList Players="TwoWay" CssClass="orange"
                                KvPPlayerIdPlayerHittingStats="KvPPlayerIdPlayerHittingStats"
                                KvPPlayerIdPlayerPitchingStats="KvPPlayerIdPlayerPitchingStats" />
                }
                <PitcherList Players="Pitchers" CssClass="pink" KvPPlayerIdPlayerPitchingStats="KvPPlayerIdPlayerPitchingStats" />
            </div>

            @if (CurrentGameStats != null)
            {
                <div class="info-sidebar">
                    <div class="stadium-container">
                        <div class="stadium" style="background-image: url('@GetStadiumUrl("day", HomeTeamDb.StadiumId)')">
                            <div class="box-score">
                                <div class="bs-row">
                                    <div class="away-score @AwayTeamDb.Team_Abreviation">
                                        <img src="@GetLogoUrl(AwayTeamDb.MLBId)" />
                                        <h1>@CurrentGameStats.Teams.Away.Runs</h1>
                                    </div>
                                    <div class="home-score @($"{HomeTeamDb.Team_Abreviation}-flip")">
                                        <h1>@CurrentGameStats.Teams.Home.Runs</h1>
                                        <img src="@GetLogoUrl(HomeTeamDb.MLBId)" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="stadium" style="background-image: url('@GetInfieldUrl()"></div>
                            @* @if (CurrentGameStats.IsTopInning)
                            {
                            <img
                                src="@GetBatterUrl(AwayTeamDb.MLBId, NewestPlay.Matchup.BatSide.Description.ToLower(), "away")"
                                     class="batter-image-@NewestPlay.Matchup.BatSide.Description.ToLower()" />
                            }
                            else
                            {
                            <img
                                src="@GetBatterUrl(HomeTeamDb.MLBId, NewestPlay.Matchup.BatSide.Description.ToLower(), "home")"
                                     class="batter-image-@NewestPlay.Matchup.BatSide.Description.ToLower()" />
                            } *@
                    </div>
                    <div class="base-occupancy">
                        <div class="bases">
                            <div class="base third  @(ThirdBaseOccupied  ? "occupied" : "")"></div>
                            <div class="base second @(SecondBaseOccupied ? "occupied" : "")"></div>
                            <div class="base first  @(FirstBaseOccupied  ? "occupied" : "")"></div>
                        </div>
                        <small>Base Occupancy</small>
                    </div>
                    <div class="table-score">
                        <table>
                            <thead>
                                <tr>
                                    <th></th>
                                    @foreach (var inning in CurrentGameStats.Innings)
                                    {
                                        <th>@inning.OrdinalNum</th>
                                    }
                                    <th>R</th>
                                    <th>H</th>
                                    <th>E</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="@AwayTeamDb.Team_Abreviation">
                                    <td class="team-box"><img src="@GetLogoUrl(AwayTeamDb.MLBId)" /></td>
                                    @foreach (var inning in CurrentGameStats.Innings)
                                    {
                                        <td>@inning.Away.Runs</td>
                                    }
                                    <td>@CurrentGameStats.Teams.Away.Runs</td>
                                    <td>@CurrentGameStats.Teams.Away.Hits</td>
                                    <td>@CurrentGameStats.Teams.Away.Errors</td>
                                </tr>
                                <tr class="@HomeTeamDb.Team_Abreviation">
                                    <td class="team-box"><img src="@GetLogoUrl(HomeTeamDb.MLBId)" /></td>
                                    @foreach (var inning in CurrentGameStats.Innings)
                                    {
                                        <td>@inning.Home.Runs</td>
                                    }
                                    <td>@CurrentGameStats.Teams.Home.Runs</td>
                                    <td>@CurrentGameStats.Teams.Home.Hits</td>
                                    <td>@CurrentGameStats.Teams.Home.Errors</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    @if (NewestPlay != null)
                    {
                        <div class="play-by-play newest">
                            <h4>Latest Play</h4>
                            <small>
                                @NewestPlay.About.HalfInning.ToUpperInvariant()
                                @NewestPlay.About.Inning — @NewestPlay.Result.Event
                            </small>
                            <div>@NewestPlay.Result.Description</div>
                        </div>
                        <div id="pitch-viz-container" style="margin-top:1rem;">
                            <!-- Pitch visualization canvas -->
                            <canvas id="pitchCanvas" width="400" height="600" style="border:1px solid #ccc;"></canvas>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public string? TeamId { get; set; }

    // Team & division info
    public TeamInfo? TeamRoster { get; set; }
    private List<TeamInfo> teams = new();

    // Record & standings
    public int Wins { get; set; }
    public int Losses { get; set; }
    public string? Standing { get; set; }
    public string? GamesBack { get; set; }
    public bool Clinched { get; set; }
    public bool HasWildCard { get; set; }
    public string? WinPercentage { get; set; }

    // Schedule & matchup
    public MatchUpResponse? MatchUp { get; set; }
    public bool HasGames { get; set; } = true;
    public string? GameTime { get; set; }
    public string? GameTimeFormat { get; set; }
    public string? GameDay { get; set; }
    public int HomeTeamWins { get; set; }
    public int HomeTeamLosses { get; set; }
    public int AwayTeamWins { get; set; }
    public int AwayTeamLosses { get; set; }
    public TeamInfo? HomeTeamDb { get; set; }
    public TeamInfo? AwayTeamDb { get; set; }

    // Roster & stats
    public MlbRosterResponse? MLBRoster { get; set; }
    public List<Player> Pitchers { get; set; } = new();
    public List<Player> Infielders { get; set; } = new();
    public List<Player> Catchers { get; set; } = new();
    public List<Player> Outfielders { get; set; } = new();
    public List<Player> DH { get; set; } = new();
    public List<Player> TwoWay { get; set; } = new();
    public Dictionary<int, MlbPlayerStatsResponse> KvPPlayerIdPlayerHittingStats { get; set; } = new();
    public Dictionary<int, MlbPlayerStatsResponse> KvPPlayerIdPlayerPitchingStats { get; set; } = new();

    // Linescore & newest play‑by‑play
    public LinescoreResponse? CurrentGameStats { get; set; }
    private PlayByPlayResponse? PlayByPlay { get; set; }
    private AllPlay? NewestPlay { get; set; }

    private bool contentLoading = true;
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDataAsync();    // loads standings, plays, etc.

            // pass the full PlayByPlayResponse to JS
            var pbpJson = JsonSerializer.Serialize(PlayByPlay);
            await JS.InvokeVoidAsync("pitchViz.initPitchViz", pbpJson);

            // start your 15 s timer
            _refreshTimer = new System.Threading.Timer(
                async _ =>
                {
                    await InvokeAsync(async () =>
                    {
                        await RefreshGameStatsAsync();
                        // re‑serialize & push to JS
                        var json = JsonSerializer.Serialize(PlayByPlay);
                        await JS.InvokeVoidAsync("pitchViz.updatePitchViz", json);
                    });
                },
                null,
                TimeSpan.FromSeconds(15),
                TimeSpan.FromSeconds(15)
            );
        }
    }


    private async Task LoadDataAsync()
    {
        contentLoading = true;
        StateHasChanged();

        // Load all teams from DB
        teams = await DbContext.TeamInfo.ToListAsync();
        TeamRoster = teams.FirstOrDefault(t => t.Id == int.Parse(TeamId!));
        if (TeamRoster == null)
        {
            contentLoading = false;
            return;
        }

        // Get standings & record
        var record = await MLBAPI.GetTeamRecord(TeamRoster.MLBId, DateTime.Now.Year);
        Wins = record.LeagueRecord.Wins;
        Losses = record.LeagueRecord.Losses;
        Standing = Ordinals.AddOrdinal(record.DivisionRank);
        GamesBack = record.GamesBack;
        Clinched = record.Records.Clinched;
        HasWildCard = record.Records.HasWildCard;
        WinPercentage = (Math.Round((double)Wins / (Wins + Losses), 4) * 100).ToString("0.00");

        // Get today's matchup
        MatchUp = await MLBAPI.GetMatchUp(TeamRoster.MLBId);
        if (MatchUp.TotalGames == 0)
        {
            HasGames = false;
        }
        else
        {
            var game = MatchUp.Dates[0].Games[0];
            HomeTeamDb = teams.FirstOrDefault(x => x.MLBId == game.Teams.Home.Team.Id);
            AwayTeamDb = teams.FirstOrDefault(x => x.MLBId == game.Teams.Away.Team.Id);
            HomeTeamWins = game.Teams.Home.LeagueRecord.Wins;
            HomeTeamLosses = game.Teams.Home.LeagueRecord.Losses;
            AwayTeamWins = game.Teams.Away.LeagueRecord.Wins;
            AwayTeamLosses = game.Teams.Away.LeagueRecord.Losses;
            GameTime = game.GameDate;
            GameTimeFormat = DateTime.TryParse(GameTime, out var dt)
                                ? dt.ToString("h:mm tt")
                                : "TBD";
            GameDay = DateTime.TryParse(game.OfficialDate, out var odt)
                                ? odt.DayOfWeek.ToString()
                                : "";
        }

        // Load roster + stats
        MLBRoster = await MLBAPI.GetTeamRoster(TeamRoster.MLBId);
        foreach (var p in MLBRoster.Roster)
        {
            KvPPlayerIdPlayerHittingStats[p.Person.Id] =
                await MLBAPI.GetPlayerSeasonStats(p.Person.Id, DateTime.Now.Year, "hitting");
            KvPPlayerIdPlayerPitchingStats[p.Person.Id] =
                await MLBAPI.GetPlayerSeasonStats(p.Person.Id, DateTime.Now.Year, "pitching");
            p.Person.Image = MLBAPI.GetPlayerImageUrl(p.Person.Id);
        }

        Pitchers = MLBRoster.Roster.Where(x => x.Position.Type == "Pitcher").ToList();
        Infielders = MLBRoster.Roster.Where(x => x.Position.Type == "Infielder").ToList();
        Catchers = MLBRoster.Roster.Where(x => x.Position.Type == "Catcher").ToList();
        Outfielders = MLBRoster.Roster.Where(x => x.Position.Type == "Outfielder").ToList();
        DH = MLBRoster.Roster.Where(x => x.Position.Type == "Hitter").ToList();
        TwoWay = MLBRoster.Roster.Where(x => x.Position.Type == "Two-Way Player").ToList();

        // Initial linescore + newest play
        if (HasGames)
        {
            var pk = MatchUp.Dates[0].Games[0].GamePk;
            await LoadCurrentGameStatsAsync(pk);

            var pbp = await PlayByPlayService.GetPlayByPlayAsync(pk);
            PlayByPlay = pbp;
            if (pbp?.AllPlays?.Any() == true)
            {
                NewestPlay = pbp.AllPlays.Last();
            }
        }

        UpdateBaseOccupancy();

        contentLoading = false;
        StateHasChanged();
    }

    // 1) occupancy flags
    public bool FirstBaseOccupied { get; set; }
    public bool SecondBaseOccupied { get; set; }
    public bool ThirdBaseOccupied { get; set; }

    // 2) helper to set them
    private void UpdateBaseOccupancy()
    {
        if (NewestPlay?.Runners != null)
        {
            FirstBaseOccupied = NewestPlay.Runners.Any(r => r.Movement.End == "1B" && r.Movement.IsOut != true);
            SecondBaseOccupied = NewestPlay.Runners.Any(r => r.Movement.End == "2B" && r.Movement.IsOut != true);
            ThirdBaseOccupied = NewestPlay.Runners.Any(r => r.Movement.End == "3B" && r.Movement.IsOut != true);
        }
        else
        {
            FirstBaseOccupied =
            SecondBaseOccupied =
            ThirdBaseOccupied = false;
        }
    }


    private async Task LoadCurrentGameStatsAsync(int gamePk)
    {
        CurrentGameStats = await MLBAPI.GetCurrentGameStats(gamePk);
    }

    private async Task RefreshGameStatsAsync()
    {
        if (HasGames)
        {
            var pk = MatchUp!.Dates[0].Games[0].GamePk;
            await LoadCurrentGameStatsAsync(pk);

            var pbp = await PlayByPlayService.GetPlayByPlayAsync(pk);
            if (pbp?.AllPlays?.Any() == true)
            {
                NewestPlay = pbp.AllPlays.Last();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    public string GetLogoUrl(int teamId) => $"https://www.mlbstatic.com/team-logos/team-cap-on-dark/{teamId}.svg";

    public string GetBatterUrl(int teamId, string batSide, string homeAway) => $"https://prod-gameday.mlbstatic.com/responsive-gameday-assets/1.3.0/images/batters/immortal/{batSide}/{teamId}-{homeAway}.png";

    public string GetStadiumUrl(string _, int stadiumId)
    {
        var isNight = DateTime.TryParse(GameTime, out var dt)
            ? dt.Hour >= 17
            : DateTime.Now.Hour >= 17;
        var time = isNight ? "night" : "day";
        return $"https://prod-gameday.mlbstatic.com/responsive-gameday-assets/1.3.0/images/stadiums/{time}/{stadiumId}@2x.jpg";
    }

    public string GetInfieldUrl() => $"https://prod-gameday.mlbstatic.com/responsive-gameday-assets/1.3.0/images/stadiums/infield/default@2x.jpg";

}
